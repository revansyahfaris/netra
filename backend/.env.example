# Salin jadi .env lalu isi. Kalau dikosongkan, API tetap jalan dalam mode demo.
GEMINI_API_KEY=
# Cocokkan nama model dengan daftar di Google AI Studio
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_VERIFIKASI=gemini-3.8-flash
GEMINI_THINKING_VERIFIKASI=low
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=1536
SERPAPI_KEY=
HTTP_TIMEOUT=30

# Kosongkan untuk SQLite lokal (backend/data/netra.db)
# Contoh Neon: postgresql://user:pass@host/db?sslmode=require
# RAG (pgvector) butuh Postgres/Neon.
DATABASE_URL=
SEED_KALAU_KOSONG=1
IZINKAN_SEED=1
# Samarkan nama akun X pribadi dan @akun di respons API (0 = tampilkan apa adanya)
SAMARKAN_AKUN=1
# 1 = ikut muat kasus nyata (data/kasus_nyata) saat seed
DEMO_KASUS_NYATA=0

# Speech-to-Text (Whisper/Groq kompatibel OpenAI; lihat docker/README.md)
# Groq cepat: STT_BASE_URL=https://api.groq.com/openai, STT_MODEL=whisper-large-v3-turbo
STT_BASE_URL=http://localhost:8100
STT_API_KEY=
# Mode CPU (server VM): Systran/faster-whisper-small | Mode GPU: deepdml/faster-whisper-large-v3-turbo-ct2 | Groq: whisper-large-v3-turbo
STT_MODEL=Systran/faster-whisper-small
STT_TIMEOUT=180
# Fallback STT ke Gemini jika layanan STT utama (Groq/Whisper) gagal atau STT_BASE_URL kosong
STT_GEMINI_FALLBACK=1
STT_GEMINI_MODEL=gemini-3.1-flash-lite

# Reverse Image Search / Google Lens untuk keyframe video (opsional saat demo)
# Isi dengan URL publik yang meneruskan ke backend ini (mis. route Cloudflare Tunnel https://netra-api.contoh.id)
PUBLIC_BASE_URL=
# Kunci tanda tangan token sementara /media-sementara/{token}. Kosong = acak tiap start.
MEDIA_SECRET=
MEDIA_TTL_DETIK=900

# Lapisan AI penuh (1 = aktif, 0 = fallback deterministik) & JIT Tier-2 RAG
PIPELINE_AI=1
JIT_TIER2=1

# --- Pengaman link publik (untuk masa penjurian) ---
# Matikan tombol "Reset data demo" agar data tidak terhapus pengunjung
# IZINKAN_SEED=0
# Batas proses live (pencarian + verifikasi berbayar) per hari, 0 = tanpa batas
BATAS_PROSES_HARIAN=0
# Jeda sebelum klaim yang sama boleh diproses ulang (menit), 0 = tanpa jeda
JEDA_PROSES_ULANG_MENIT=0
