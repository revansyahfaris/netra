# Salin jadi .env lalu isi. Kalau dikosongkan, API tetap jalan dalam mode demo.
GEMINI_API_KEY=
# Cocokkan nama model dengan daftar di Google AI Studio
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_VERIFIKASI=gemini-3.8-flash
SERPAPI_KEY=
# Connection string Neon (postgresql://...). Kosong = data di memori.
DATABASE_URL=
HTTP_TIMEOUT=30
