# Salin jadi .env lalu isi. Kalau dikosongkan, API tetap jalan dalam mode demo.
GEMINI_API_KEY=
# Cocokkan nama model dengan daftar di Google AI Studio
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_VERIFIKASI=gemini-3.8-flash
SERPAPI_KEY=
HTTP_TIMEOUT=30

# Kosongkan untuk SQLite lokal (backend/data/netra.db)
# Contoh Neon: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
SEED_KALAU_KOSONG=1
IZINKAN_SEED=1
# 1 = ikut muat kasus nyata (data/kasus_nyata) saat seed
DEMO_KASUS_NYATA=0
